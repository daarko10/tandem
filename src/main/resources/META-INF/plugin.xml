<idea-plugin>
    <id>dev.daarkolabs.tandem</id>
    <name>Tandem</name>
    <vendor url="https://daarkolabs.com">DaArKo Labs</vendor>

    <description><![CDATA[
    A fast, native chat inside JetBrains IDEs that works with Claude Code.<br/>
    Uses your own installed <code>claude</code> CLI and its sign-in; Tandem never reads your credentials.
    Claude's edits go through the IDE: each one opens in the native diff viewer (unless you choose to accept edits
    automatically), where you can change the proposal before accepting it, and lands through the editor, so undo and unsaved buffers work. Claude is told what the file
    now says. <code>@</code> in the prompt picks a file, and the editor's selection can go with the prompt.<br/><br/>
    Tandem is an independent project and is not affiliated with or endorsed by Anthropic.
    Claude and Claude Code are trademarks of Anthropic, PBC.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- IDE content modules the Jewel UI uses. Each one must be declared to be visible at runtime. -->
    <dependencies>
        <module name="intellij.platform.jewel.foundation"/>
        <module name="intellij.platform.jewel.ui"/>
        <module name="intellij.platform.jewel.ideLafBridge"/>
        <module name="intellij.platform.jewel.markdown.core"/>
        <module name="intellij.platform.jewel.markdown.ideLafBridgeStyling"/>
        <module name="intellij.platform.jewel.markdown.extensions.autolink"/>
        <module name="intellij.platform.jewel.markdown.extensions.gfmTables"/>
        <module name="intellij.platform.jewel.markdown.extensions.gfmStrikethrough"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Tandem"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"
                    canCloseContents="true"
                    factoryClass="dev.daarkolabs.tandem.ui.TandemToolWindowFactory"/>
        <notificationGroup id="Tandem" displayType="BALLOON"/>
        <applicationConfigurable parentId="tools"
                                 id="dev.daarkolabs.tandem.settings"
                                 displayName="Tandem"
                                 instance="dev.daarkolabs.tandem.ide.TandemSettingsConfigurable"/>
        <!-- Development-only: does nothing unless -Dtandem.spike or -Dtandem.autoPrompt is set. -->
        <postStartupActivity implementation="dev.daarkolabs.tandem.ui.dev.DevStartupActivity"/>
    </extensions>

    <actions>
        <action id="Tandem.CyclePermissionMode"
                class="dev.daarkolabs.tandem.ui.CyclePermissionModeAction"
                text="Cycle Permission Mode"
                description="Switch the Tandem chat to the next permission mode: Manual, Accept edits, Plan, then Auto when the model supports it">
            <keyboard-shortcut keymap="$default" first-keystroke="shift TAB"/>
        </action>
        <action id="Tandem.NewSession"
                class="dev.daarkolabs.tandem.ui.NewSessionAction"
                icon="AllIcons.General.Add"
                text="New Session"
                description="Start a new Tandem session with the last model, effort and permission mode"/>
        <action id="Tandem.AddFilesOrPhotos"
                class="dev.daarkolabs.tandem.ui.AddFilesOrPhotosAction"
                text="Add Files or Photos"
                description="Attach images to the Tandem prompt">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift O"/>
        </action>
    </actions>
</idea-plugin>
